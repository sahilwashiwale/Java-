package Practice;

public class Fourth {

	public static void main(String[] args) {
		
		
		int counter=0;
		for(int i=2;i<1000;i++)
		{
			boolean flag=false;
            for(int j=2;j<i;j++)
            {
            	if(i%j==0)
            	{
            		flag=true;
            		break;
            	}
            }
            
            if(flag==false)
            	{
            	System.out.println(i);
            	counter++;
            	}
            if(counter==10)
            {
            	break;
            }
            
            			
		}
		System.out.println(counter);
		
		
	}

}
