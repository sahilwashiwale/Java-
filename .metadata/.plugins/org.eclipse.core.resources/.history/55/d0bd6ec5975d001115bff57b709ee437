package Practice;

public class Fourth {

	public static void main(String[] args) {
		
		int [] arr = new int [1000];
		int counter=0;
		for(int i=0;i<arr.length;i++)
		{
			boolean flag=false;
            for(int j=2;j<=i;j++)
            {
            	if(i%j==0)
            	{
            		flag=true;
            		break;
            	}
            }
            
            if(flag==true)
            	{
            	counter++;
            	System.out.println(counter);
            	}
            
            			
		}
		
		
	}

}
