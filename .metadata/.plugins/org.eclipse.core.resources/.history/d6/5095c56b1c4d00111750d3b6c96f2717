package Inheritance;

public class SingleLevel {

	public static void main(String[] args) {
		
		Two two = new Two();
		two.run();
		two.name="Sahil";
		System.out.println(two.name);
				
	}

}
class One{
	String name;
	public One(String name)
	{
		this.name=name;
	}
	public void run()
	{
		System.out.println("Runnnnnnn");
	}
}
class Two extends One{
	
}
